# SPA history fallback for React Router (Hostinger / Apache).
# Files in web/public/ are copied verbatim into web/dist/ by Vite, so this
# ships to the document root of matter.stellarinfomatica.com.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# Correct MIME for the Web App Manifest (older Apache builds default to text/plain).
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
</IfModule>

# Long-cache hashed Vite assets; never cache the entry HTML or the service
# worker / manifest (immutable would freeze SW updates for a year).
<IfModule mod_headers.c>
  <FilesMatch "\.(?:css|woff2?|ttf|otf|eot|svg|png|jpg|jpeg|gif|webp|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Hashed app bundles only — exclude SW / workbox / register helpers.
  <FilesMatch "^(?!sw\.js$|registerSW\.js$|workbox-)[A-Za-z0-9._-]+\.js$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "(sw\.js|registerSW\.js|workbox-.*\.js|manifest\.webmanifest)$">
    Header set Cache-Control "no-store"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-store"
  </FilesMatch>
</IfModule>
